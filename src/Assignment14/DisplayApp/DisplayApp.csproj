<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup Label="CSharpAnalyser">
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MathApp\MathApp.csproj" />
    <ProjectReference Include="..\UtilityApp\UtilityApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MathApp">
      <HintPath>..\MathApp\bin\Debug\net6.0\MathApp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
